# ==============================================================================
# LungCare AI Backend - Environment Configuration
# ==============================================================================

# Application Metadata
APP_NAME="LungCare AI API"
APP_VERSION="1.0.0"
ENVIRONMENT="development"
# In production, DEBUG must remain false to prevent leaking exception internals.
# Set DEBUG=true only for local developer debugging.
DEBUG=false
# Explicit toggle for interactive Swagger (/docs), Redoc (/redoc), and OpenAPI (/openapi.json).
# In production, leave unset or set to false. In development/staging, set to true if needed.
ENABLE_DOCS=true
API_V1_PREFIX="/api/v1"
LOG_LEVEL="INFO"

# Networking & Server
HOST="0.0.0.0"
PORT=8000

# Image Preprocessing & Upload Guardrails (Phase 2.2.3)
MAX_IMAGE_UPLOAD_BYTES=10485760
MAX_IMAGE_PIXELS=25000000
ALLOWED_IMAGE_FORMATS=["JPEG","PNG","WEBP"]
IMAGE_TARGET_SIZE=224

# CORS Allowed Origins
# Specify JSON array or comma-delimited strings of exact origins.
# Wildcard '*' is strictly prohibited when credentials are enabled.
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

